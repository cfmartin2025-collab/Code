# Copy to .env and fill in. NEVER commit .env.
ICLOUD_USERNAME=you@icloud.com
# appleid.apple.com -> Sign-In and Security -> App-Specific Passwords
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
CAL_TIMEZONE=America/Chicago
# 1 = read-only (no create/update/delete tools exposed)
CAL_READ_ONLY=0
# Optional: only expose these calendars (comma-separated display names)
CAL_ALLOWED_CALENDARS=

# --- Remote (HTTP) mode only ---
# python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_PATH_TOKEN=
# Public hostname of your tunnel, e.g. cal.yourdomain.com
MCP_PUBLIC_HOST=
